    "net/minecraft/resources/ResourceKey|location|()Lnet/minecraft/resources/ResourceLocation;": "identifier",
    "net/minecraft/world/level/LevelHeightAccessor|getMinBuildHeight|()I": "getMinY",
    "net/minecraft/world/level/LevelHeightAccessor|getMaxBuildHeight|()I": "getMaxY",
    "net/minecraft/core/RegistryAccess|registryOrThrow|(Lnet/minecraft/resources/ResourceKey;)Lnet/minecraft/core/Registry;": "lookupOrThrow",
    "net/minecraft/server/level/ServerLevel|getStructureManager|()Lnet/minecraft/world/level/levelgen/structure/templatesystem/StructureTemplateManager;": "getStructureTemplateManager",
    "net/minecraft/core/Registry|getHolder|(Lnet/minecraft/resources/ResourceKey;)Ljava/util/Optional;": "getOptional",
    "net/minecraft/core/Registry|get|(Lnet/minecraft/resources/ResourceKey;)Ljava/lang/Object;": "getValue",
    "net/minecraft/core/Holder|value|()Ljava/lang/Object;": "value",
    "net/minecraft/resources/ResourceKey|registry|()Lnet/minecraft/resources/ResourceLocation;": "registry"
  }
